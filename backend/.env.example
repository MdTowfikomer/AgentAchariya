# Agent Acharya — backend settings. Copy to .env.local and fill in.

# LiveKit Cloud project (https://cloud.livekit.io -> Settings -> Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Gemini runs voice, lesson planning, and the visual director.
# Live web research uses the separate SerpApi key below.
# https://aistudio.google.com/apikey — use a billed project.
GOOGLE_API_KEY=your_google_api_key_here

# Live Google search evidence for lessons (https://serpapi.com/manage-api-key).
SERPAPI_API_KEY=your_serpapi_api_key_here

# Topic images: Klein overview, Schnell follow-ups, and standalone previews.
# Cloudflare token needs Workers AI access for this account.
# CLOUDFLARE_ACCOUNT_ID=your_32_character_account_id
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
# Enabled automatically when both credentials are set. Set 0 to disable.
# IMAGE_GENERATION_ENABLED=1

# Optional: Postgres, to remember students between classes and record analytics.
# DATABASE_URL=postgresql://user:password@host/dbname

# Optional model overrides
# LIVE_MODEL=gemini-3.8-live
# LIVE_VOICE=Puck
# PLANNER_MODEL=gemini-3.8-flash
# DIRECTOR_MODEL=gemini-3.8-flash
