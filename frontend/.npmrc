# pnpm's default isolated linker builds paths like
#   node_modules/.pnpm/<name>@<version>_<long-peer-hash>/node_modules/<name>
# which exceeds the Windows 260-char MAX_PATH under this repo's directory depth.
# Node tolerates that; Turbopack's resolver does not, so the dev server fails
# with "Module not found" for packages that have long peer hashes.
# Hoisting flattens node_modules and keeps every path well under the limit.
node-linker=hoisted
